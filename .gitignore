# ============================================
# DSHub - Unified .gitignore
# ============================================

# ============================================
# Build Output & Distribution
# ============================================
dist/
build/

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ============================================
# Testing & Coverage
# ============================================
/coverage
*.lcov

# ============================================
# Logs
# ============================================
logs/
*.log

# ============================================
# Runtime Data
# ============================================
pids
*.pid
*.seed
*.pid.lock

# ============================================
# Cache & Temporary Files
# ============================================
.cache

# ============================================
# IDE & Editor Files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ============================================
# OS Generated Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================
# Python (Emulator)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
# Third-party Libraries (cloned manually, not submodules)
# ============================================
libs/
external/

# ============================================
# AUR Package Build Artifacts
# ============================================
aur-bin/pkg/
aur-bin/src/
aur-bin/*.pkg.tar.zst
aur-bin/*.pkg.tar.xz
aur-bin/*.tar.gz
aur-bin/*.zip
aur-bin/MAINTAINER_GUIDE.md

# ============================================
# Development & Documentation (Keep in Git)
# ============================================
# Keep these files - they're important
!README.md
!QUICK_START.md
!emulator/README.md
!aur-bin/PKGBUILD
!aur-bin/.SRCINFO
!aur-bin/README.md

.claude/ScreenHome.png
.claude/ScreenHome2.png
.claude/ScreenHome3.png
.claude/ScreenHome4.png
.claude/ScreenHome5.png
.claude/ScreenHome6.png
.claude/ScreenHome7.png

# Temporary local files
tmp/
scripts/
SCE2-Files/

# Native Rust build artifacts
/target/
